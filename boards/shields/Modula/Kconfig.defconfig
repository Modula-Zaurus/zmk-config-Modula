if SHIELD_MODULA_R
    config ZMK_SPLIT_ROLE_CENTRAL
        default y
    config BT_MAX_CONN
        default 8
    config BT_MAX_PAIRED
        default 8
endif

if SHIELD_MODULA_R||SHIELD_MODULA_L
    config ZMK_KEYBOARD_NAME
        default "Modula"

    config ZMK_SPLIT
        default y
    
endif 

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT